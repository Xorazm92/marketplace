# INBOLA backend. Server shu ro'yxatni Joi bilan tekshiradi (src/config/environment.config.ts):
# majburiy qiymat yo'q yoki secret 32 belgidan qisqa bo'lsa, ishga tushmaydi.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://inbola:CHANGE_ME@127.0.0.1:5432/inbola_marketplace

# Har biri kamida 32 belgi: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_OTP_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

FRONTEND_URL=http://localhost:5000
# Vergul bilan bir nechta domen
CORS_ORIGIN=http://localhost:5000

# SMS (Eskiz). Prodda majburiy; dev'da bo'sh qolsa OTP kod log'ga yoziladi.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
SMS_FROM=4546

# Payme: merchant id berilsa kalit majburiy. Sandbox: https://checkout.test.paycom.uz
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
# Payme kabinetidagi endpoint: https://<domen>/api/v1/payments/payme

# Click SHOP API: service id berilsa secret majburiy.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Click kabinetidagi Prepare: https://<domen>/api/v1/payments/click/prepare
# Click kabinetidagi Complete: https://<domen>/api/v1/payments/click/complete

CASH_ON_DELIVERY_ENABLED=true

# Yetkazish (so'm). FREE_SHIPPING_FROM=0 — bepul yetkazish chegarasi yo'q.
SHIPPING_FLAT_FEE=0
FREE_SHIPPING_FROM=0

# Prodda Swagger (/api/docs) default o'chiq.
SWAGGER_ENABLED=false
