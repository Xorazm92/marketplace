{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2020",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "strictNullChecks": false,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "moduleResolution": "node",
    "lib": [
      "ES2020"
    ],
    "esModuleInterop": true
  },
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "dist",
    "node_modules",
    "src/**/*.resolver.ts",
    "src/address/**",
    "src/admin/**",
    "src/auth/**",
    "src/cart/types/**",
    "src/chat/**",
    "src/child-safety/**",
    "src/color/**",
    "src/colors/**",
    "src/common/common.module.ts",
    "src/common/guards/**",
    "src/common/interceptors/**",
    "src/common/middleware/**",
    "src/common/patterns/**",
    "src/common/services/**",
    "src/config/performance.config.ts",
    "src/config/rate-limiter.config.ts",
    "src/config/security.config.ts",
    "src/config/swagger.config.ts",
    "src/currency/**",
    "src/domain/**",
    "src/email/**",
    "src/inventory/**",
    "src/logger/**",
    "src/mail/**",
    "src/microservices/**",
    "src/model/**",
    "src/notification/**",
    "src/order/dto/update-order.dto.ts",
    "src/order/types/**",
    "src/otp/**",
    "src/payment/**",
    "src/payment_method/**",
    "src/phone_number/**",
    "src/product/**",
    "src/schema.gql",
    "src/security/**",
    "src/seller/**",
    "src/shared/**",
    "src/telegram/**",
    "src/test/**",
    "src/testing/**",
    "src/uploads/**",
    "src/user-auth/**",
    "src/user/**",
    "src/utils/**",
    "src/wishlist/types/**",
    "test/e2e/**"
  ]
}
