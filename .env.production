# Production Environment Configuration - INBOLA Marketplace
# Uzbekistan Production Settings

# Application
NODE_ENV=production
PORT=3000
API_PORT=4000
DOMAIN=inbola.uz
API_DOMAIN=api.inbola.uz
CDN_DOMAIN=cdn.inbola.uz

# Database
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/inbola_production
REDIS_URL=redis://localhost:6379

# JWT & Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-this-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_EXPIRATION=30d

# Payment Providers - Uzbekistan
CLICK_MERCHANT_ID=your_click_merchant_id_here
CLICK_SERVICE_ID=your_click_service_id_here
CLICK_SECRET_KEY=your_click_secret_key_here
CLICK_WEBHOOK_SECRET=your_click_webhook_secret_here

PAYME_MERCHANT_ID=your_payme_merchant_id_here
PAYME_LOGIN=your_payme_login_here
PAYME_PASSWORD=your_payme_password_here
PAYME_WEBHOOK_SECRET=your_payme_webhook_secret_here

UZUM_MERCHANT_ID=your_uzum_merchant_id_here
UZUM_API_KEY=your_uzum_api_key_here
UZUM_SECRET_KEY=your_uzum_secret_key_here
UZUM_WEBHOOK_SECRET=your_uzum_webhook_secret_here

# 3D-Secure Configuration
THREEDS_RETURN_URL=https://inbola.uz/payment/return
THREEDS_WEBHOOK_URL=https://api.inbola.uz/webhooks/3ds

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_S3_BUCKET=inbola-production
AWS_S3_REGION=us-east-1
CLOUDFRONT_DISTRIBUTION_ID=your_cloudfront_distribution_id

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=inbola
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# SMS Configuration - Uzbekistan
SMS_UZ_API_KEY=your_sms_uz_api_key_here
SMS_UZ_SENDER=INBOLA
SMS_UZ_WEBHOOK_SECRET=your_sms_uz_webhook_secret_here

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@inbola.uz
SMTP_PASS=your_smtp_app_password_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Monitoring
DATADOG_API_KEY=your_datadog_api_key_here
DATADOG_APP_KEY=your_datadog_app_key_here
SENTRY_DSN=your_sentry_dsn_here
UPTIMEROBOT_API_KEY=your_uptimerobot_api_key_here

# Security
SECURITY_REPORT_URI=https://api.inbola.uz/security/report

# Uzbekistan Specific
UZ_TAX_RATE=15
UZ_CURRENCY=UZS
UZ_LOCALE=uz-UZ

# Backup
BACKUP_S3_BUCKET=inbola-backups
BACKUP_RETENTION_DAYS=30

# SSL
SSL_CERT_PATH=/etc/letsencrypt/live/inbola.uz/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/inbola.uz/privkey.pem
